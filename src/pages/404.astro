---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="404 — Page Not Found | icra.contractors"
  description="The page you requested was not found. Return to icra.contractors to explore this premium ICRA contractor domain."
  noindex={true}
>
  <div class="min-h-[80vh] flex items-center justify-center px-5 bg-icra-surface">
    <div class="text-center max-w-md">
      <p class="font-display text-7xl sm:text-8xl font-extrabold tracking-tighter text-icra-teal mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl font-semibold text-icra-ink mb-4">Page Not Found</h1>
      <p class="text-slate-500 mb-8 text-sm sm:text-base leading-relaxed">
        That page does not exist. Head home to explore the opportunity to own icra.contractors.
      </p>
      <a href="/"
         class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-icra-teal hover:bg-icra-deep text-white font-semibold text-sm transition-all">
        Return Home
      </a>
    </div>
  </div>
</MainLayout>
