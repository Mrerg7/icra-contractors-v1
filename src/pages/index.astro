---
import MainLayout from '../layouts/MainLayout.astro';

const contactEmail = 'sales@desertrich.com';
const subjectLine = 'Acquisition Inquiry — icra.contractors';
const mailtoLink = `mailto:${contactEmail}?subject=${encodeURIComponent(subjectLine)}`;
const askingPrice = '$45,000';
const siteUrl = 'https://icra.contractors';

const marketStats = [
  {
    value: '$30B+',
    label: 'Annual U.S. hospital & clinic construction spend',
    detail:
      'Ongoing projects create continuous demand for qualified ICRA contractors who can work safely in occupied healthcare environments.',
  },
  {
    value: 'Major Gap',
    label: 'Finding vetted ICRA contractors is difficult',
    detail:
      'Hospitals and general contractors frequently struggle to identify reliable contractors with genuine ICRA training and field experience.',
  },
  {
    value: 'Clear Play',
    label: 'A trusted network has strong commercial value',
    detail:
      'A vetted network or platform of ICRA-trained contractors can command premium positioning and recurring value for both sides of the market.',
  },
];

const brandPillars = [
  {
    title: 'Vetted Contractor Network',
    desc: 'A trusted network of ICRA-trained contractors and crews that hospitals and general contractors can confidently engage for healthcare projects.',
  },
  {
    title: 'Directory & Matching Platform',
    desc: 'A searchable directory or matching platform that helps project owners quickly find qualified ICRA contractors by location, trade, certification, and experience.',
  },
  {
    title: 'Training & Certification Standards',
    desc: 'Establish and maintain clear training and certification standards so project owners know exactly what level of ICRA expertise they are getting.',
  },
  {
    title: 'Trust & Risk Reduction',
    desc: 'By creating a vetted network with clear standards, the brand reduces risk for hospitals and GCs while giving qualified contractors better access to high-value work.',
  },
];

const domainValues = [
  {
    title: '.contractors TLD Advantage',
    desc: 'The .contractors extension instantly communicates a network, directory, or platform of multiple contractors — purpose-built for this niche.',
  },
  {
    title: 'Category Leadership Potential',
    desc: 'The name positions you as the central brand for ICRA contractors — whether as a network, directory, matching platform, or standards organization.',
  },
  {
    title: 'Memorable & Descriptive',
    desc: 'Short, clear, and easy to understand. Strong for a platform website, outbound marketing, and explaining the model to contractors and project owners.',
  },
  {
    title: 'Strong Search Alignment',
    desc: 'Excellent fit for searches like “ICRA contractors”, “healthcare construction contractors”, “ICRA trained contractors”, and related high-intent B2B terms.',
  },
  {
    title: 'Scalable Business Models',
    desc: 'Supports directory membership, matching fees, certification programs, training networks, sponsorships, and lead generation.',
  },
  {
    title: 'Future-Proof Demand',
    desc: 'Healthcare construction will always need qualified ICRA contractors. This brand stays relevant as the go-to network or platform in the space.',
  },
];

const businessModels = [
  {
    title: 'Vetted ICRA Contractor Network',
    desc: 'Build a national or regional network of trained ICRA contractors that hospitals and GCs can confidently engage.',
  },
  {
    title: 'Directory & Matching Platform',
    desc: 'Create a searchable directory or matching platform that connects projects with qualified ICRA contractors by location and trade.',
  },
  {
    title: 'Training & Certification Program',
    desc: 'Establish training standards and a certification program that contractors can earn and project owners can trust.',
  },
  {
    title: 'Lead Generation & Brokerage',
    desc: 'Generate and broker leads for ICRA-trained contractors while giving project owners vetted options and lower risk.',
  },
];

const buyerProfiles = [
  {
    title: 'Network & Platform Builders',
    desc: 'Create a vetted network or matching platform that connects healthcare projects with qualified ICRA contractors.',
  },
  {
    title: 'Directory & Marketplace Founders',
    desc: 'Build the go-to directory or marketplace for finding and engaging ICRA-trained contractors.',
  },
  {
    title: 'Training & Certification Organizations',
    desc: 'Establish training standards and a certification program under a category-owning brand.',
  },
  {
    title: 'Lead Generation Businesses',
    desc: 'Create a lead generation or brokerage service that connects project owners with vetted ICRA contractors.',
  },
  {
    title: 'Industry Standards Groups',
    desc: 'Position your organization as the central standards and best-practice body for ICRA contractors.',
  },
  {
    title: 'Strategic Investors',
    desc: 'Acquire a highly descriptive .contractors domain with clear commercial application in a regulated niche.',
  },
];

const faqs = [
  {
    q: 'What is icra.contractors?',
    a: 'icra.contractors is a premium .contractors domain positioned as the category brand for a network, directory, or platform of Infection Control Risk Assessment (ICRA) contractors serving healthcare construction.',
  },
  {
    q: 'Why is this domain valuable for SEO and brand authority?',
    a: 'The name maps directly to high-intent searches for ICRA contractors and healthcare construction specialists. Exact-match, descriptive domains help brand recall, trust, and topical authority when backed by strong on-page content and clean technical SEO.',
  },
  {
    q: 'Who is the ideal buyer?',
    a: 'Marketplace founders, contractor networks, training/certification organizations, lead-gen operators, and investors building category leadership in healthcare construction compliance.',
  },
  {
    q: 'Is the domain available for purchase now?',
    a: `Yes. icra.contractors is available for acquisition. Asking price is ${askingPrice} USD. Serious inquiries are handled confidentially with escrow-protected transfer.`,
  },
  {
    q: 'How does the transfer work?',
    a: 'Qualified buyers agree on terms, complete payment through professional escrow, and receive a verified domain transfer. Typical closing time is 1–5 business days after agreement.',
  },
  {
    q: 'What business models fit this brand?',
    a: 'Contractor directories, matching platforms, certification programs, training networks, sponsorship marketplaces, and lead brokerage all map cleanly to the .contractors TLD.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${siteUrl}/#faq`,
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
  ],
};
---

<MainLayout extraSchema={[faqSchema, breadcrumbSchema]}>
  <nav class="bg-white/90 backdrop-blur-md border-b border-icra-border sticky top-0 z-50" aria-label="Primary">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-4 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 min-w-0" aria-label="icra.contractors home">
        <div class="w-8 h-8 sm:w-9 sm:h-9 bg-icra-teal rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <div class="font-display tracking-tight text-[15px] xs:text-base sm:text-2xl whitespace-nowrap">
          <span class="font-bold">icra</span><span class="text-icra-teal font-bold">.contractors</span>
        </div>
      </a>

      <div class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600">
        <a href="#opportunity" class="hover:text-icra-deep transition-colors">Opportunity</a>
        <a href="#brand" class="hover:text-icra-deep transition-colors">Brand</a>
        <a href="#why-domain" class="hover:text-icra-deep transition-colors">Why This Domain</a>
        <a href="#faq" class="hover:text-icra-deep transition-colors">FAQ</a>
        <a href="#acquire" class="hover:text-icra-deep transition-colors">Acquire</a>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
        <a href={mailtoLink} class="hidden sm:inline-flex px-4 py-2.5 text-sm font-semibold border border-slate-300 hover:border-slate-400 text-slate-700 rounded-full transition-all">
          Make an Offer
        </a>
        <a href="#acquire" class="px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold bg-icra-teal hover:bg-icra-deep text-white rounded-full transition-all shadow-sm whitespace-nowrap">
          Inquire Now
        </a>
        <button type="button" class="md:hidden w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center text-slate-700 rounded-full border border-slate-200" id="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-icra-border bg-white px-5 py-4">
      <div class="flex flex-col gap-1 text-sm font-semibold">
        <a href="#opportunity" class="py-2.5 text-slate-700">Opportunity</a>
        <a href="#brand" class="py-2.5 text-slate-700">Brand</a>
        <a href="#why-domain" class="py-2.5 text-slate-700">Why This Domain</a>
        <a href="#faq" class="py-2.5 text-slate-700">FAQ</a>
        <a href="#acquire" class="py-2.5 text-slate-700">Acquire</a>
        <a href={mailtoLink} class="mt-2 block w-full py-3 text-center bg-icra-teal text-white rounded-full">Inquire Now</a>
      </div>
    </div>
  </nav>

  <main id="main">
    <header class="healthcare-gradient text-white">
      <div class="relative z-10 max-w-6xl mx-auto px-5 sm:px-8 pt-16 pb-20 sm:pt-20 sm:pb-24">
        <div class="max-w-3xl animate-slide-up">
          <p class="inline-flex items-center gap-2 bg-white/10 border border-white/20 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse-slow" aria-hidden="true"></span>
            Domain for sale · Escrow-ready
          </p>

          <h1 class="font-display text-[2.35rem] leading-[1.05] sm:text-6xl md:text-7xl sm:leading-[0.95] tracking-tight font-extrabold mb-5 break-words">
            icra.contractors
          </h1>

          <p class="text-xl sm:text-2xl text-teal-50/95 tracking-tight mb-4 max-w-2xl">
            The network brand for ICRA contractors in healthcare construction.
          </p>

          <p class="text-base sm:text-lg text-teal-100/85 mb-8 max-w-2xl leading-relaxed">
            Own the .contractors domain that positions you as the hub connecting hospitals and GCs with trained Infection Control Risk Assessment contractors.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
            <a href="#acquire" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-icra-deep font-semibold rounded-full hover:bg-teal-50 transition-all shadow-xl shadow-black/15">
              Secure This Domain
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
            <a href="#opportunity" class="inline-flex items-center justify-center px-7 py-3.5 border border-white/30 hover:bg-white/10 text-white font-medium rounded-full transition-all">
              Explore the Opportunity
            </a>
          </div>

          <p class="mt-8 text-sm text-teal-100/80">
            Asking <span class="font-semibold text-white">{askingPrice}</span> · Flexible structures · Confidential inquiries
          </p>
        </div>
      </div>
    </header>

    <section class="border-b border-icra-border bg-white/80">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-5 grid sm:grid-cols-3 gap-4 text-sm text-slate-600">
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span>.contractors TLD signals a contractor network or platform</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span>Hospitals &amp; GCs struggle to find reliable ICRA crews</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span>Clear demand for a vetted ICRA contractor marketplace</span>
        </div>
      </div>
    </section>

    <section id="opportunity" class="max-w-6xl mx-auto px-5 sm:px-8 pt-16 pb-12 reveal">
      <p class="uppercase tracking-[0.18em] text-icra-teal text-xs font-bold mb-2">The Market</p>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight leading-tight max-w-3xl">
        Finding reliable ICRA-trained contractors remains a major pain point for hospitals and GCs.
      </h2>
      <p class="mt-4 text-lg text-slate-600 max-w-3xl leading-relaxed">
        Healthcare construction requires crews who understand infection control. Most project owners still struggle to identify and vet ICRA-trained specialty contractors — creating space for a trusted network, directory, or platform that reduces risk and speeds bidding.
      </p>

      <div class="mt-10 grid md:grid-cols-3 gap-4">
        {marketStats.map((stat) => (
          <article class="bg-white border border-icra-border rounded-2xl p-6 modern-card">
            <div class="text-4xl font-display font-bold tracking-tight text-icra-ink">{stat.value}</div>
            <h3 class="text-icra-teal font-semibold mt-2">{stat.label}</h3>
            <p class="text-sm text-slate-500 mt-3 leading-relaxed">{stat.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="brand" class="bg-white border-y border-icra-border py-16 reveal">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <p class="uppercase tracking-[0.18em] text-icra-teal text-xs font-bold mb-2">The Brand</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight leading-tight max-w-3xl">
          What icra.contractors represents.
        </h2>
        <p class="mt-4 text-lg text-slate-600 max-w-3xl leading-relaxed">
          This is the brand for the network, directory, or platform that connects healthcare projects with qualified ICRA contractors — building trust, reducing risk, and streamlining crew selection for infection-sensitive work.
        </p>

        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {brandPillars.map((pillar) => (
            <article class="bg-icra-surface border border-icra-border rounded-2xl p-5 modern-card">
              <h3 class="font-semibold text-lg tracking-tight mb-2">{pillar.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{pillar.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="why-domain" class="max-w-6xl mx-auto px-5 sm:px-8 py-16 reveal">
      <p class="uppercase tracking-[0.18em] text-icra-teal text-xs font-bold mb-2">Strategic Asset</p>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight leading-tight max-w-3xl mb-8">
        Why icra.contractors is a powerful brand.
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {domainValues.map((item) => (
          <article class="bg-white border border-icra-border p-6 rounded-2xl modern-card">
            <h3 class="font-semibold text-lg tracking-tight mb-2">{item.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{item.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-icra-dark text-white py-16 reveal" aria-labelledby="models-heading">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <p class="text-teal-300 text-xs tracking-[0.18em] font-bold mb-2">Activation Paths</p>
        <h2 id="models-heading" class="font-display text-3xl sm:text-4xl tracking-tight font-bold max-w-2xl">
          High-potential ways to activate icra.contractors.
        </h2>

        <div class="mt-9 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {businessModels.map((model) => (
            <article class="bg-white/5 border border-white/10 p-5 rounded-2xl hover:bg-white/10 transition-colors">
              <h3 class="font-semibold mb-2 text-sm sm:text-base">{model.title}</h3>
              <p class="text-sm text-white/70 leading-relaxed">{model.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-5 sm:px-8 py-16 border-b border-icra-border reveal">
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-3">
        Who should acquire icra.contractors?
      </h2>
      <p class="text-lg text-slate-600 max-w-3xl">
        Ideal for entrepreneurs and organizations ready to build the central network or platform for ICRA contractors.
      </p>

      <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-5 text-sm">
        {buyerProfiles.map((profile) => (
          <article>
            <h3 class="font-semibold text-base text-icra-ink">{profile.title}</h3>
            <p class="text-slate-600 mt-1 leading-relaxed">{profile.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="faq" class="bg-white border-b border-icra-border py-16 reveal">
      <div class="max-w-3xl mx-auto px-5 sm:px-8">
        <p class="uppercase tracking-[0.18em] text-icra-teal text-xs font-bold mb-2">Common Questions</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-8">
          icra.contractors — acquisition &amp; ICRA FAQ
        </h2>

        <div class="flex flex-col gap-3">
          {faqs.map((item) => (
            <details class="group border border-icra-border rounded-2xl bg-icra-surface overflow-hidden">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 sm:px-6 py-4 font-semibold text-slate-800 hover:bg-teal-50/60 transition-colors">
                <span class="text-base">{item.q}</span>
                <svg class="w-4 h-4 shrink-0 text-icra-teal transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              </summary>
              <div class="px-5 sm:px-6 pb-5 -mt-1 text-sm text-slate-600 leading-relaxed">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="acquire" class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20 reveal">
      <div class="grid lg:grid-cols-2 gap-10 items-start">
        <div>
          <div class="inline-block premium-badge mb-4 text-xs">Exclusive Opportunity</div>
          <h2 class="font-display text-4xl sm:text-5xl tracking-tight font-bold mb-4">
            Own the network brand for ICRA contractors.
          </h2>
          <p class="text-lg text-slate-600 max-w-xl leading-relaxed">
            icra.contractors is available for acquisition. Secure the .contractors domain that positions you as the central hub for specialized ICRA contractors in healthcare construction.
          </p>

          <div class="mt-6 inline-flex items-center gap-3 bg-icra-teal-pale border border-icra-teal/20 rounded-full px-5 py-2.5">
            <span class="text-sm text-slate-600">Asking price</span>
            <span class="text-xl font-bold text-icra-deep">{askingPrice} USD</span>
          </div>

          <ul class="mt-7 space-y-3 text-sm text-slate-600">
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>Professional escrow — funds released only after verified transfer</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>Typical close in 1–5 business days after agreement</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>Confidential handling — flexible transaction structures available</span>
            </li>
          </ul>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={mailtoLink} class="px-7 py-3.5 bg-icra-teal hover:bg-icra-deep transition-all text-white font-semibold rounded-full text-center shadow-lg shadow-icra-teal/25">
              Email an Offer
            </a>
            <a href={mailtoLink} class="px-7 py-3.5 border border-slate-300 hover:bg-slate-100 transition-all font-medium text-slate-700 rounded-full text-center">
              {contactEmail}
            </a>
          </div>
        </div>

        <div class="bg-white border border-icra-border rounded-3xl p-6 sm:p-8 shadow-xl shadow-slate-900/5">
          <h3 class="text-xl font-bold tracking-tight mb-1">Submit an acquisition inquiry</h3>
          <p class="text-sm text-slate-500 mb-6">Qualified inquiries receive transfer details and escrow instructions.</p>

          <form id="inquiry-form" action="https://formsubmit.co/sales@desertrich.com" method="POST" class="flex flex-col gap-4">
            <input type="hidden" name="_subject" value="icra.contractors Acquisition Inquiry" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_next" value="https://icra.contractors/#acquire" />
            <input type="hidden" name="Domain" value="icra.contractors" />
            <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="inq-name" class="block text-xs font-semibold text-slate-600 mb-1.5">Name *</label>
                <input id="inq-name" type="text" name="Name" required autocomplete="name"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-icra-teal focus:ring-2 focus:ring-icra-teal/20 outline-none text-sm transition-all"
                  placeholder="Your name" />
              </div>
              <div>
                <label for="inq-email" class="block text-xs font-semibold text-slate-600 mb-1.5">Email *</label>
                <input id="inq-email" type="email" name="Email" required autocomplete="email"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-icra-teal focus:ring-2 focus:ring-icra-teal/20 outline-none text-sm transition-all"
                  placeholder="you@company.com" />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="inq-company" class="block text-xs font-semibold text-slate-600 mb-1.5">Company</label>
                <input id="inq-company" type="text" name="Company" autocomplete="organization"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-icra-teal focus:ring-2 focus:ring-icra-teal/20 outline-none text-sm transition-all"
                  placeholder="Company name" />
              </div>
              <div>
                <label for="inq-offer" class="block text-xs font-semibold text-slate-600 mb-1.5">Offer (USD)</label>
                <input id="inq-offer" type="text" name="Offer" inputmode="numeric"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-icra-teal focus:ring-2 focus:ring-icra-teal/20 outline-none text-sm transition-all"
                  placeholder="e.g. 45000" />
              </div>
            </div>

            <div>
              <label for="inq-message" class="block text-xs font-semibold text-slate-600 mb-1.5">Message</label>
              <textarea id="inq-message" name="Message" rows="4"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-icra-teal focus:ring-2 focus:ring-icra-teal/20 outline-none text-sm transition-all resize-y"
                placeholder="Timeline, preferred structure, or questions…"></textarea>
            </div>

            <button type="submit" id="inquiry-submit"
              class="w-full py-3.5 bg-icra-teal hover:bg-icra-deep transition-all text-white font-semibold rounded-full text-sm shadow-lg shadow-icra-teal/25 active:scale-[0.985]">
              Send Acquisition Inquiry
            </button>

            <p id="form-status" role="status" aria-live="polite" class="text-sm text-center min-h-[1.25rem] text-slate-600"></p>
            <p class="text-xs text-slate-400 text-center -mt-1">
              Or email <a href={mailtoLink} class="text-icra-teal hover:underline font-medium">{contactEmail}</a> directly.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <div class="sticky-cta fixed bottom-0 left-0 right-0 z-50 sm:hidden px-4 py-3">
    <a href="#acquire" class="cta-primary w-full py-3 rounded-full text-white font-semibold text-sm flex items-center justify-center gap-2">
      Inquire to Acquire — Own This Domain
    </a>
  </div>

  <footer class="relative bg-icra-dark text-slate-400 pb-24 sm:pb-0">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-14">
      <div class="text-center mb-10">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 font-display">Domain Available for Acquisition</h2>
        <p class="text-white/55 text-sm sm:text-base mb-6 max-w-xl mx-auto leading-relaxed">
          icra.contractors — the .contractors domain for a network, directory, or platform of specialized ICRA contractors. Serious inquiries welcome. Escrow-protected.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={mailtoLink} class="inline-flex items-center gap-2 px-7 py-3 rounded-full border border-icra-teal/40 hover:bg-icra-teal hover:text-white text-icra-teal-bright font-semibold text-sm transition-all">
            {contactEmail}
          </a>
          <a href="#acquire" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 hover:bg-white/5 text-white/70 font-medium text-sm transition-all">
            Request Information Package
          </a>
        </div>
      </div>

      <div class="border-t border-white/10 pt-8">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-[11px] sm:text-xs text-white/35 leading-relaxed mb-4">
            This website is for informational purposes only. It does not constitute an offer of services or a guarantee of outcomes. Market figures are based on publicly available information and are subject to change.
          </p>
          <p class="text-[11px] sm:text-xs text-white/25 font-mono">
            &copy; {new Date().getFullYear()} icra.contractors — Built with Astro + Cloudflare Workers
          </p>
        </div>
      </div>
    </div>
  </footer>
</MainLayout>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
    });
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
      const href = this.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        const navHeight = 72;
        const offsetPosition = target.getBoundingClientRect().top + window.scrollY - navHeight;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
        if (history.replaceState) history.replaceState(null, '', href);
      }
    });
  });

  const inquiryForm = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const inquiryBtn = document.getElementById('inquiry-submit') as HTMLButtonElement | null;
  const formStatus = document.getElementById('form-status');
  if (inquiryForm && inquiryBtn && formStatus) {
    inquiryForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honey = inquiryForm.querySelector('input[name="_honey"]') as HTMLInputElement | null;
      if (honey?.value) return;
      inquiryBtn.disabled = true;
      inquiryBtn.textContent = 'Sending…';
      formStatus.textContent = '';
      formStatus.classList.remove('text-emerald-600', 'text-red-500');
      try {
        const res = await fetch('https://formsubmit.co/ajax/sales@desertrich.com', {
          method: 'POST',
          body: new FormData(inquiryForm),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('request failed');
        inquiryForm.reset();
        formStatus.textContent = 'Thank you — your inquiry has been sent. Expect a reply shortly.';
        formStatus.classList.add('text-emerald-600');
      } catch {
        formStatus.textContent = 'Sending failed — please email sales@desertrich.com directly.';
        formStatus.classList.add('text-red-500');
      } finally {
        inquiryBtn.disabled = false;
        inquiryBtn.textContent = 'Send Acquisition Inquiry';
      }
    });
  }

  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }
</script>
